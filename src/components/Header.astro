---
const links = [
  { href: '/#about', label: 'About' },
  { href: '/#lessons', label: 'Lessons & fees' },
  { href: '/#contact', label: 'Contact' },
];
---
<header class="site-header">
  <div class="container">
    <a class="brand" href="/">
      <img src="/logo.png" alt="Primary School Maths Tutoring logo" width="58" height="48" />
      Ed Alexander
    </a>
    <nav>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </div>
</header>
